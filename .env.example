# Copy to .env and fill in values
# Never commit .env to git

# Required for Brave Search discovery
BRAVE_API_KEY=

# Optional: override jobs.json path (useful for testing)
JOBS_JSON_PATH=

# Optional: Upwork credentials (for browser-based scanner)
UPWORK_USERNAME=
UPWORK_PASSWORD=

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
